# EXAMPLE ONLY. Review existing host Nginx configuration, port ownership,
# certificate lineage and authentication policy before installing.

server {
    listen 80;
    listen [::]:80;
    server_name staging.theclearpill.online;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name staging.theclearpill.online;

    ssl_certificate     /etc/letsencrypt/live/theclearpill.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/theclearpill.online/privkey.pem;

    # Staging must remain protected until production authentication exists.
    # Choose ONE reviewed control, for example:
    # auth_basic "The Clear Pill staging";
    # auth_basic_user_file /etc/nginx/htpasswd-the-clear-pill;
    # or an explicit allow/deny IP policy.

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:3070;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }
}
